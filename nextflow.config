params {
  outdir = 'output'
  mindepth = 1
  maxdepth = 50
  min_mapqual = 30
  exclude_flag = '2308'
  keepbam = false
  threads = 4
  fastp = false
  multiqc = true
  fastp_args = ''
  mafft = false
  mafft_args = '--auto'
  bwa_index_args = '-a is'
  bwa_args = '-k 15'
  bcftools_consensus = true
  samtools_a_consensus = true
  samtools_iupac_consensus = true
  samtools_a_iupac_consensus = true
}

process {
  cpus = { params.threads as int }
}

conda {
  enabled = false
  useMamba = true
}

apptainer {
  enabled = true
  autoMounts = true
}
