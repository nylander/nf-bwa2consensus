params {
  outdir = "output"
  mindepth = 1
  maxdepth = 50
  keepbam = false
  threads = 4
  fastp = false
  fastp_args = ''
}

process {
  cpus = { params.threads as int }
}

conda {
  enabled = true
  useMamba = true
  createOptions = '-q'
}

singularity {
  enabled = false
  autoMounts = true
}
